#!/bin/bash
# /root/bin/dorami-deploy-worker —— 部署的唯一 owner:锁、跨版本状态与门禁(issue #102 方案 §4.4)。
# DORAMI_DEPLOY_WORKER_VERSION=1
#
# 在仓库外、与 SSH 会话脱离(launcher 用 setsid 起它),不随目标 tag 切换而变。承担一切**跨版本**的事:
#   token / ref / 协议核验、锁、in-progress / last-success 事务(含 prev 镜像采样与自做 DB 备份)、方向判定与
#   单调护栏、首装门、清理与晋升、退出码。目标 tag 里的 ./deploy-docker.sh 只做它自己那一版的构建与验证。
#
# 子命令:
#   run <vX.Y.Z> <sha40> <downgrade 0|1> <redeploy 0|1>   由 launcher 调用;stdio 重定向到 $LOG_DIR/<tag>-<sha7>.log
#   --close-in-progress                                   人工关闭未收口事务(恢复备份 / 放弃失败部署之后)
#   status                                                打印 state / in-progress / last-success
#
# 退出码(写进 $STATE_DIR/<tag>-<sha7>.rc,launcher 以它退出):
#   0 成功(含回放)  2 用法  4 锁被占  10 ref 核验失败  11 协议不支持  20 in-progress 冲突
#   21 单调护栏     22 迁移文件变化  23 首装门  24 事务准备失败  其它 = 目标脚本 deploy-docker.sh 的退出码
#
# 支持的目标脚本协议(目标 tag 的 scripts/deploy-lib.sh 须宣告 DORAMI_DEPLOY_PROTOCOL=<n>):
WORKER_MAX_PROTOCOL=1

set -uo pipefail
umask 077

CONF="${DORAMI_DEPLOY_CONF:-/etc/dorami-deploy.conf}"
[ -r "$CONF" ] || { echo "ERROR: 配置不存在或不可读: $CONF" >&2; exit 2; }
# shellcheck disable=SC1090
source "$CONF"
: "${REPO_DIR:?conf 缺 REPO_DIR}" "${STATE_DIR:?conf 缺 STATE_DIR}" "${LOG_DIR:?conf 缺 LOG_DIR}" "${LOCK_FILE:?conf 缺 LOCK_FILE}"
export PATH="${DEPLOY_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
# 环境卫生:不继承 sshd / 调用方带来的 git / docker / compose 变量
while IFS= read -r _v; do unset "$_v"; done < <(compgen -e | grep -E '^(GIT_|DOCKER_|COMPOSE_)' || true)
BACKUP_KEEP="${DORAMI_DEPLOY_BACKUP_KEEP:-10}"

IN_PROGRESS="$STATE_DIR/in-progress.json"
LAST_SUCCESS="$STATE_DIR/last-success.json"
STATE="$STATE_DIR/state.json"
TOKEN="$STATE_DIR/first-install.token"

# ── JSON 助手(python3;所有写都是 tmp + fsync + rename + fsync 目录)──
json_get() {  # file key [default]
    python3 - "$1" "$2" "${3-}" <<'PY'
import json, sys
path, key, default = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    cur = json.load(open(path, encoding="utf-8"))
except Exception:
    print(default); sys.exit(0)
for part in key.split("."):
    if isinstance(cur, dict) and part in cur:
        cur = cur[part]
    else:
        print(default); sys.exit(0)
if cur is None:
    print(default)
elif isinstance(cur, bool):
    print("true" if cur else "false")
else:
    print(cur)
PY
}
json_list() {  # file key → 一行一项
    python3 - "$1" "$2" <<'PY'
import json, sys
try:
    cur = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    sys.exit(0)
for part in sys.argv[2].split("."):
    cur = cur.get(part) if isinstance(cur, dict) else None
for item in (cur or []):
    print(item)
PY
}
_json_dump_atomic() {  # path ; data via stdin(python 内部用)
    python3 - "$1" <<'PY'
import json, os, sys, tempfile
path = sys.argv[1]; data = json.load(sys.stdin)
d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2, sort_keys=True); f.flush(); os.fsync(f.fileno())
os.replace(tmp, path)
dfd = os.open(d, os.O_RDONLY); os.fsync(dfd); os.close(dfd)
PY
}
json_set() {  # file key value [json]  —— 第 4 参为 json 时 value 按 JSON 字面量解析
    python3 - "$1" "$2" "$3" "${4-}" <<'PY'
import json, os, sys, tempfile
path, key, raw, kind = sys.argv[1:5]
try:
    data = json.load(open(path, encoding="utf-8"))
except Exception:
    data = {}
value = json.loads(raw) if kind == "json" else raw
cur = data
parts = key.split(".")
for part in parts[:-1]:
    cur = cur.setdefault(part, {})
cur[parts[-1]] = value
d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2, sort_keys=True); f.flush(); os.fsync(f.fileno())
os.replace(tmp, path)
dfd = os.open(d, os.O_RDONLY); os.fsync(dfd); os.close(dfd)
PY
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
proc_start_id() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed 's/^ *//;s/ *$//'; }
sha256_file() { python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$1"; }
meta() { printf 'DORAMI_DEPLOY_META %s=%s\n' "$1" "$(printf '%s' "$2" | tr -c 'A-Za-z0-9._:/=-' '_')"; }

sqlite_path_from_ini() {  # 与 scripts/deploy-lib.sh 同一 awk;相对路径按 REPO_DIR 解析
    local ini="$1" url
    [ -f "$ini" ] || return 0
    url="$(awk -F '=' '
        /^[[:space:]]*[#;]/ { next }
        /^[[:space:]]*\[/ { in_section = ($0 ~ /^[[:space:]]*\[storage\][[:space:]]*$/); next }
        in_section && $1 ~ /^[[:space:]]*database_url[[:space:]]*$/ {
            sub(/^[^=]*=/, ""); sub(/[[:space:]]*[#;].*$/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print; exit
        }' "$ini")"
    local p=""
    case "$url" in
        sqlite:///*) p="${url#sqlite:///}" ;;
        "") p="data/cms_data.db" ;;
        *) echo ""; return 0 ;;
    esac
    case "$p" in /*) echo "$p" ;; *) echo "$REPO_DIR/$p" ;; esac
}
backup_sqlite() {  # src dst(在线一致快照;与 deploy-lib 同算法)
    if command -v sqlite3 >/dev/null 2>&1; then
        sqlite3 "$1" ".backup '$2'"
    else
        python3 - "$1" "$2" <<'PY'
import sqlite3, sys
with sqlite3.connect(sys.argv[1]) as a, sqlite3.connect(sys.argv[2]) as b:
    a.backup(b)
PY
    fi
}

# ── 子命令:status / --close-in-progress ──
cmd_status() {
    for f in "$STATE" "$IN_PROGRESS" "$LAST_SUCCESS"; do
        echo "== $f =="; [ -f "$f" ] && cat "$f" || echo "(无)"
    done
}
cmd_close_in_progress() {
    mkdir -p "$STATE_DIR"
    exec 9>>"$LOCK_FILE" || { echo "ERROR: 打不开锁文件 $LOCK_FILE" >&2; exit 4; }
    python3 -c 'import fcntl,sys; fcntl.flock(int(sys.argv[1]), fcntl.LOCK_EX|fcntl.LOCK_NB)' 9 2>/dev/null \
        || { echo "ERROR: 有部署正在进行(锁被占),不能关闭事务" >&2; exit 4; }
    [ -f "$IN_PROGRESS" ] || { echo "没有未收口的 in-progress 事务"; exit 0; }
    local txn; txn="$(json_get "$IN_PROGRESS" txn_id unknown)"
    mv "$IN_PROGRESS" "$STATE_DIR/closed-${txn}.json"
    rm -f "$STATE_DIR/${txn}.switch"
    echo "已关闭事务 ${txn} → $STATE_DIR/closed-${txn}.json(managed 镜像与备份留给下次成功部署的清理)"
}

# ── run ──
RC_FILE=""; FINALIZED=""
finalize() {
    local code=$?
    [ -n "$FINALIZED" ] && return
    FINALIZED=1
    [ -f "$STATE" ] || return
    json_set "$STATE" phase finalizing
    if [ -n "$RC_FILE" ]; then
        python3 - "$RC_FILE" "$code" <<'PY'
import os, sys, tempfile
path, code = sys.argv[1], sys.argv[2]
d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
with os.fdopen(fd, "w") as f:
    f.write(code + "\n"); f.flush(); os.fsync(f.fileno())
os.replace(tmp, path)
dfd = os.open(d, os.O_RDONLY); os.fsync(dfd); os.close(dfd)
PY
        json_set "$STATE" rc_file "$RC_FILE"
    fi
    json_set "$STATE" rc "$code" json
    json_set "$STATE" finished_at "$(now_iso)"
    json_set "$STATE" phase complete
    echo "dorami-deploy-worker: 结束,退出码 $code($(now_iso))"
}
die() { local code="$1"; shift; echo "ERROR: $*"; exit "$code"; }

cmd_run() {
    [ $# -eq 4 ] || { echo "用法: $0 run <vX.Y.Z> <sha40> <0|1> <0|1>" >&2; exit 2; }
    TAG="$1"; SHA="$2"; DOWNGRADE="$3"; REDEPLOY="$4"
    [[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ && "$SHA" =~ ^[0-9a-f]{40}$ && "$DOWNGRADE" =~ ^[01]$ && "$REDEPLOY" =~ ^[01]$ ]] \
        || { echo "ERROR: 参数格式错误" >&2; exit 2; }

    mkdir -p "$STATE_DIR" "$LOG_DIR" "$(dirname "$LOCK_FILE")" 2>/dev/null || true
    # 锁先于一切状态写入:抢不到就退出,绝不覆盖正在跑的 worker 的 state
    exec 9>>"$LOCK_FILE" || exit 4
    python3 -c 'import fcntl,sys; fcntl.flock(int(sys.argv[1]), fcntl.LOCK_EX|fcntl.LOCK_NB)' 9 2>/dev/null || exit 4

    LOG="$LOG_DIR/${TAG}-${SHA:0:7}.log"
    RC_FILE="$STATE_DIR/${TAG}-${SHA:0:7}.rc"
    rm -f "$RC_FILE"
    python3 - "$STATE" "$TAG" "$SHA" "$DOWNGRADE" "$REDEPLOY" "$$" "$(proc_start_id $$)" "$LOG" "$(now_iso)" <<'PY'
import json, os, sys, tempfile
path = sys.argv[1]
data = {
    "tag": sys.argv[2], "target_sha": sys.argv[3], "downgrade": sys.argv[4] == "1", "redeploy": sys.argv[5] == "1",
    "worker_pid": int(sys.argv[6]), "worker_start_id": sys.argv[7], "child_pid": None, "child_start_id": None,
    "phase": "starting", "log": sys.argv[8], "started_at": sys.argv[9], "rc_file": None, "rc": None,
}
d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2, sort_keys=True); f.flush(); os.fsync(f.fileno())
os.replace(tmp, path)
dfd = os.open(d, os.O_RDONLY); os.fsync(dfd); os.close(dfd)
PY
    exec >>"$LOG" 2>&1
    trap finalize EXIT
    echo "=================================================="
    echo "  dorami-deploy-worker v${WORKER_MAX_PROTOCOL} — ${TAG} ${SHA:0:7} downgrade=${DOWNGRADE} redeploy=${REDEPLOY} ($(now_iso))"
    echo "=================================================="
    meta target_tag "$TAG"; meta target_sha "$SHA"

    step_reconcile_crash_window
    step_verify_ref
    step_verify_protocol
    step_in_progress
    step_replay
    step_baseline
    step_guard
    step_migration_diff
    step_first_install
    step_open_txn
    step_child
    step_finish
}

step_reconcile_crash_window() {
    # 「last-success 已提交、in-progress 未删」的崩溃窗口:按 txn_id 判定,幂等删除;令牌同理按摘要幂等消费。
    if [ -f "$IN_PROGRESS" ] && [ -f "$LAST_SUCCESS" ] \
       && [ "$(json_get "$IN_PROGRESS" txn_id a)" = "$(json_get "$LAST_SUCCESS" txn_id b)" ]; then
        echo "[0/13] 上次已晋升但事务未删(崩溃窗口):幂等收口 $(json_get "$IN_PROGRESS" txn_id)"
        rm -f "$IN_PROGRESS"
    fi
    if [ -f "$IN_PROGRESS" ] && [ -f "$TOKEN" ]; then
        local want; want="$(json_get "$IN_PROGRESS" token_digest "")"
        [ -n "$want" ] && [ "$(sha256_file "$TOKEN")" = "$want" ] && { echo "[0/13] 首装令牌已被事务消费但文件仍在:幂等删除"; rm -f "$TOKEN"; }
    fi
}

step_verify_ref() {
    echo "[1/13] 核验 ref(fail closed)..."
    cd "$REPO_DIR" 2>/dev/null || die 10 "REPO_DIR 不存在: $REPO_DIR"
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 10 "$REPO_DIR 不是 git 仓库"
    git fetch --tags --quiet origin || die 10 "git fetch --tags origin 失败(流水线模式不回落到本地 tag)"
    git fetch --quiet origin main || die 10 "git fetch origin main 失败"
    local tag_sha
    tag_sha="$(git rev-parse -q --verify "refs/tags/${TAG}^{commit}" 2>/dev/null)" || die 10 "tag 不存在: $TAG"
    [ "$tag_sha" = "$SHA" ] || die 10 "tag $TAG 指向 ${tag_sha:0:7},与 Actions 核验的 ${SHA:0:7} 不一致(tag 被移动?)"
    git merge-base --is-ancestor "$SHA" origin/main || die 10 "${SHA:0:7} 不在 origin/main 线上"
    local version
    version="$(git show "${SHA}:src/version.py" 2>/dev/null | grep -o '__version__ = "[^"]*"' | head -1 | sed 's/.*"\(.*\)"/\1/')"
    [ "v${version}" = "$TAG" ] || die 10 "目标提交的版本号 ${version:-?} 与 tag $TAG 不一致"
    echo "    OK: $TAG → ${SHA:0:7},在 origin/main 上,版本号 $version"
}

step_verify_protocol() {
    echo "[2/13] 核验部署协议..."
    local proto
    proto="$(git show "${SHA}:scripts/deploy-lib.sh" 2>/dev/null | grep -E '^DORAMI_DEPLOY_PROTOCOL=[0-9]+' | head -1 | cut -d= -f2)"
    [ -n "$proto" ] || die 11 "目标 tag 未宣告 DORAMI_DEPLOY_PROTOCOL(早于流水线协议的版本):流水线拒绝,请在生产机手工 ./deploy-docker.sh $TAG"
    if [ "$proto" -lt 1 ] || [ "$proto" -gt "$WORKER_MAX_PROTOCOL" ]; then
        die 11 "目标协议 $proto 超出本 worker 支持范围(1..$WORKER_MAX_PROTOCOL):先升级 /root/bin/dorami-deploy-worker"
    fi
    PROTOCOL="$proto"; meta protocol "$proto"
    echo "    OK: 协议 $proto"
}

REUSE=0
step_in_progress() {
    echo "[3/13] in-progress 事务判定..."
    [ -f "$IN_PROGRESS" ] || { echo "    无未收口事务"; return 0; }
    local t_tag t_sha txn switched
    t_tag="$(json_get "$IN_PROGRESS" target.tag)"; t_sha="$(json_get "$IN_PROGRESS" target.sha)"; txn="$(json_get "$IN_PROGRESS" txn_id)"
    if [ "$t_tag" = "$TAG" ] && [ "$t_sha" = "$SHA" ]; then
        REUSE=1; echo "    复用未收口事务 $txn(同 target,上次失败后的重试)"; return 0
    fi
    switched="$(json_get "$IN_PROGRESS" switched_at "")"
    if [ -z "$switched" ] && [ ! -e "$STATE_DIR/${txn}.switch" ]; then
        echo "    上次目标 $t_tag ${t_sha:0:7} 在 up 之前就失败,系统未被改动:自动关闭事务 $txn"
        mv "$IN_PROGRESS" "$STATE_DIR/closed-${txn}.json"
        return 0
    fi
    die 20 "存在已切换未收口的事务 $txn(target $t_tag ${t_sha:0:7}):先按 docs/release-process.md 恢复,再 dorami-deploy-worker --close-in-progress"
}

step_replay() {
    echo "[4/13] 回放判定..."
    [ "$REUSE" = 0 ] || { echo "    复用事务,不回放"; return 0; }
    [ -f "$LAST_SUCCESS" ] || { echo "    无 last-success"; return 0; }
    if [ "$(json_get "$LAST_SUCCESS" target.tag)" = "$TAG" ] && [ "$(json_get "$LAST_SUCCESS" target.sha)" = "$SHA" ]; then
        if [ "$REDEPLOY" = 1 ]; then echo "    redeploy=1:忽略 last-success,重新完整部署"; return 0; fi
        echo "    last-success 已是 $TAG ${SHA:0:7}(deployed_at $(json_get "$LAST_SUCCESS" deployed_at)):回放成功,不重新部署"
        meta replay 1
        exit 0
    fi
    echo "    last-success 是 $(json_get "$LAST_SUCCESS" target.tag),继续"
}

BASE_SHA=""; BASE_REF=""; DIRECTION="unknown"
step_baseline() {
    echo "[5/13] 基线与方向..."
    local src="unknown" cid
    if [ -f "$LAST_SUCCESS" ]; then
        BASE_SHA="$(json_get "$LAST_SUCCESS" target.sha)"; BASE_REF="$(json_get "$LAST_SUCCESS" target.tag)"; src="last-success"
    else
        cid="$(docker compose ps -q backend 2>/dev/null | head -1 || true)"
        if [ -n "$cid" ]; then
            local envs; envs="$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$cid" 2>/dev/null || true)"
            BASE_SHA="$(printf '%s\n' "$envs" | grep '^DORAMI_BUILD_SHA=' | head -1 | cut -d= -f2-)"
            BASE_REF="$(printf '%s\n' "$envs" | grep '^DORAMI_BUILD_REF=' | head -1 | cut -d= -f2-)"
            [ -n "$BASE_SHA" ] && src="container"
        fi
    fi
    if [ -n "$BASE_SHA" ] && git cat-file -e "${BASE_SHA}^{commit}" 2>/dev/null; then
        if [ "$BASE_SHA" = "$SHA" ]; then DIRECTION="same"
        elif git merge-base --is-ancestor "$BASE_SHA" "$SHA"; then DIRECTION="forward"
        elif git merge-base --is-ancestor "$SHA" "$BASE_SHA"; then DIRECTION="downgrade"
        else DIRECTION="unrelated"; fi
    fi
    echo "    基线 ${BASE_REF:-unknown} ${BASE_SHA:0:7}(来源 $src),方向 $DIRECTION"
    meta baseline_ref "${BASE_REF:-unknown}"; meta baseline_sha "${BASE_SHA:-unknown}"; meta direction "$DIRECTION"
}

step_guard() {
    echo "[6/13] 单调护栏..."
    case "$DIRECTION" in
        forward|same) echo "    OK: 向前 / 同一提交" ;;
        *)
            [ "$DOWNGRADE" = 1 ] || die 21 "目标不高于当前基线(方向 $DIRECTION,基线 ${BASE_REF:-unknown}):自动路径拒绝;显式降级请 dispatch 时勾选 allow_downgrade"
            echo "    downgrade=1:人为确认放行(方向 $DIRECTION)" ;;
    esac
}

step_migration_diff() {
    echo "[7/13] 迁移文件变化提示(按方向解释)..."
    if [ -z "$BASE_SHA" ] || [ "$DIRECTION" = "same" ]; then
        meta migration_files "${BASE_SHA:+none}${BASE_SHA:-unknown}"
        [ -z "$BASE_SHA" ] && echo "    ⚠️  基线未知,无法比较迁移文件(不显示 0)"
        return 0
    fi
    local diff a m d
    diff="$(git diff --name-status "$BASE_SHA" "$SHA" -- alembic/versions 2>/dev/null || true)"
    a="$(printf '%s\n' "$diff" | grep -c '^A' || true)"; m="$(printf '%s\n' "$diff" | grep -c '^M' || true)"; d="$(printf '%s\n' "$diff" | grep -c '^D' || true)"
    echo "    A=$a M=$m D=$d(基线 ${BASE_SHA:0:7} → 目标 ${SHA:0:7})"
    meta migration_files_added "$a"; meta migration_files_modified "$m"; meta migration_files_deleted "$d"
    case "$DIRECTION" in
        forward)
            [ "$m" = 0 ] && [ "$d" = 0 ] || die 22 "向前部署却有迁移文件被改写 / 删除(M=$m D=$d):迁移历史被篡改,fail closed" ;;
        downgrade)
            [ "$m" = 0 ] || die 22 "降级时两边共有的迁移文件被改写(M=$m):fail closed"
            [ "$d" = 0 ] || echo "    降级:目标尚无后续 revision(D=$d 为预期),兼容性由目标镜像的迁移计划判定" ;;
        *)
            [ "$m" = 0 ] && [ "$d" = 0 ] || die 22 "方向 $DIRECTION 下有迁移文件 M/D(M=$m D=$d):fail closed" ;;
    esac
}

FRESH_OK=0; TOKEN_DIGEST=""
step_first_install() {
    echo "[8/13] 首装门..."
    if [ "$REUSE" = 1 ]; then
        [ "$(json_get "$IN_PROGRESS" fresh_authorized false)" = "true" ] && FRESH_OK=1
        echo "    复用事务:沿用事务内 fresh_authorized=$FRESH_OK(不重新按证据推翻)"; meta fresh_ok "$FRESH_OK"; return 0
    fi
    local evidence="" db
    [ -n "$(docker compose ps -a -q 2>/dev/null || true)" ] && evidence="$evidence containers"
    [ -n "$(ls -A "$REPO_DIR/backups" 2>/dev/null || true)" ] && evidence="$evidence backups"
    docker image ls --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -qE '^dorami-(backend|nginx)-(managed|rollback):' && evidence="$evidence images"
    [ -f "$LAST_SUCCESS" ] && evidence="$evidence last-success"
    db="$(sqlite_path_from_ini "$REPO_DIR/config/production.ini")"
    [ -n "$db" ] && [ -f "$db" ] && evidence="$evidence database"
    if [ -n "$evidence" ]; then
        echo "    有部署证据($evidence):目标镜像若报 fresh 将 fail closed(库路径 / 卷 / 文件丢失,绝不起空站)"
    elif [ -f "$TOKEN" ]; then
        TOKEN_DIGEST="$(sha256_file "$TOKEN")"; FRESH_OK=1
        echo "    无部署证据 + 首装令牌 $TOKEN:允许 fresh(令牌在事务落盘后消费)"
    else
        echo "    无部署证据也无首装令牌:目标镜像若报 fresh 将 fail closed(首装请 touch $TOKEN)"
    fi
    meta fresh_ok "$FRESH_OK"
}

TXN=""
step_open_txn() {
    echo "[9/13] in-progress 事务..."
    if [ "$REUSE" = 1 ]; then
        TXN="$(json_get "$IN_PROGRESS" txn_id)"
        echo "    复用 $TXN:不重新采样 prev 镜像、不重做备份(此时 DB 可能已迁移、容器可能已是失败的新版本)"
        meta txn_id "$TXN"; return 0
    fi
    TXN="$(python3 -c 'import uuid,time; print(f"{int(time.time())}-{uuid.uuid4().hex[:8]}")')"
    local from_ref="${BASE_REF:-unknown}"; from_ref="${from_ref//\//_}"
    local b_cid n_cid b_img="" n_img="" managed_b="" managed_n="" backup="" db
    b_cid="$(docker compose ps -q backend 2>/dev/null | head -1 || true)"
    n_cid="$(docker compose ps -q nginx 2>/dev/null | head -1 || true)"
    if [ -n "$b_cid" ]; then
        b_img="$(docker inspect --format '{{.Image}}' "$b_cid" 2>/dev/null || true)"
        [ -n "$b_img" ] || die 24 "无法 inspect backend 容器 $b_cid 的镜像"
        managed_b="dorami-backend-managed:${from_ref}-${TXN}"
        docker tag "$b_img" "$managed_b" || die 24 "docker tag $managed_b 失败"
    fi
    if [ -n "$n_cid" ]; then
        n_img="$(docker inspect --format '{{.Image}}' "$n_cid" 2>/dev/null || true)"
        [ -n "$n_img" ] || die 24 "无法 inspect nginx 容器 $n_cid 的镜像"
        managed_n="dorami-nginx-managed:${from_ref}-${TXN}"
        docker tag "$n_img" "$managed_n" || die 24 "docker tag $managed_n 失败"
    fi
    db="$(sqlite_path_from_ini "$REPO_DIR/config/production.ini")"
    if [ -n "$db" ] && [ -f "$db" ]; then
        mkdir -p "$REPO_DIR/backups"
        backup="$REPO_DIR/backups/$(basename "$db").$(date +%Y%m%d-%H%M%S).pre-${TAG}"
        backup_sqlite "$db" "$backup" || die 24 "DB 备份失败: $backup"
        [ -s "$backup" ] || die 24 "DB 备份为空: $backup"
    fi
    python3 - "$IN_PROGRESS" "$TXN" "$TAG" "$SHA" "$BASE_REF" "$BASE_SHA" "$b_img" "$n_img" "$managed_b" "$managed_n" "$backup" "$FRESH_OK" "$TOKEN_DIGEST" "$(now_iso)" <<'PY'
import json, os, sys, tempfile
(path, txn, tag, sha, base_ref, base_sha, b_img, n_img, managed_b, managed_n, backup, fresh_ok, token_digest, opened) = sys.argv[1:15]
data = {
    "txn_id": txn,
    "target": {"tag": tag, "sha": sha},
    "prev": {
        "ref": base_ref, "sha": base_sha,
        "backend_image_id": b_img, "nginx_image_id": n_img,
        "managed_tags": [t for t in (managed_b, managed_n) if t],
        "db_backup": backup,
    },
    "opened_at": opened, "switched_at": None,
    "fresh_authorized": fresh_ok == "1", "token_digest": token_digest,
}
d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2, sort_keys=True); f.flush(); os.fsync(f.fileno())
os.replace(tmp, path)
dfd = os.open(d, os.O_RDONLY); os.fsync(dfd); os.close(dfd)
PY
    [ -n "$TOKEN_DIGEST" ] && rm -f "$TOKEN" && echo "    首装令牌已消费"
    echo "    事务 $TXN 已落盘:prev backend ${b_img:-无} / nginx ${n_img:-无},备份 ${backup:-无}"
    meta txn_id "$TXN"; meta db_backup "${backup:-none}"
}

CHILD_RC=1; SWITCH_MARK=""
step_child() {
    echo "[10/13] 执行目标脚本 ./deploy-docker.sh $TAG(origin=pipeline,expected ${SHA:0:7})..."
    SWITCH_MARK="$STATE_DIR/${TXN}.switch"
    json_set "$STATE" phase running
    (
        cd "$REPO_DIR" && exec env \
            DORAMI_DEPLOY_ORIGIN=pipeline DORAMI_EXPECTED_SHA="$SHA" DORAMI_DEPLOY_LOCK_FD=9 \
            DORAMI_DEPLOY_SWITCH_MARK="$SWITCH_MARK" DORAMI_DEPLOY_FRESH_OK="$FRESH_OK" DORAMI_DEPLOY_TAG="$TAG" \
            DORAMI_DEPLOY_MIN_FREE_GB="${DORAMI_DEPLOY_MIN_FREE_GB:-5}" DORAMI_DEPLOY_BACKUP_KEEP="$BACKUP_KEEP" \
            DORAMI_DEPLOY_LOCK_FILE="$LOCK_FILE" ${DORAMI_HTTP_LISTEN:+DORAMI_HTTP_LISTEN="$DORAMI_HTTP_LISTEN"} \
            ./deploy-docker.sh "$TAG"
    ) &
    local child=$!
    json_set "$STATE" child_pid "$child" json
    json_set "$STATE" child_start_id "$(proc_start_id "$child")"
    wait "$child"; CHILD_RC=$?
    if [ -e "$SWITCH_MARK" ]; then
        json_set "$IN_PROGRESS" switched_at "$(now_iso)"
        echo "    目标脚本已越过切换点(up)"
    fi
    echo "    目标脚本退出码 $CHILD_RC"
    meta child_rc "$CHILD_RC"
}

step_finish() {
    if [ "$CHILD_RC" != 0 ]; then
        echo "[11/13] 部署失败:in-progress 事务 $TXN 保留(暂存镜像与备份不动,可重试复用或人工恢复),last-success 不变"
        exit "$CHILD_RC"
    fi
    echo "[11/13] 晋升 last-success..."
    python3 - "$IN_PROGRESS" "$LAST_SUCCESS" "$(now_iso)" <<'PY'
import json, os, sys, tempfile
src, dst, deployed_at = sys.argv[1:4]
data = json.load(open(src, encoding="utf-8"))
data["deployed_at"] = deployed_at
d = os.path.dirname(dst) or "."
fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2, sort_keys=True); f.flush(); os.fsync(f.fileno())
os.replace(tmp, dst)
dfd = os.open(d, os.O_RDONLY); os.fsync(dfd); os.close(dfd)
PY
    rm -f "$IN_PROGRESS" "$SWITCH_MARK"
    local b n
    b="$(json_get "$LAST_SUCCESS" prev.backend_image_id "")"; n="$(json_get "$LAST_SUCCESS" prev.nginx_image_id "")"
    [ -n "$b" ] && docker tag "$b" dorami-backend-rollback:auto >/dev/null 2>&1 || true
    [ -n "$n" ] && docker tag "$n" dorami-nginx-rollback:auto >/dev/null 2>&1 || true
    echo "    last-success = $TAG ${SHA:0:7}(txn $TXN);:auto alias 指向 prev"
    step_cleanup
    echo "[13/13] 完成"
}

step_cleanup() {
    echo "[12/13] 清理(只删不被 last-success 引用的 managed 镜像与超保留数的备份;不跑 builder prune)..."
    local referenced tag
    referenced="$(json_list "$LAST_SUCCESS" prev.managed_tags)"
    for tag in $(docker image ls --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -E '^dorami-(backend|nginx)-managed:' || true); do
        if printf '%s\n' "$referenced" | grep -qxF "$tag"; then continue; fi
        docker rmi "$tag" >/dev/null 2>&1 && echo "    rmi $tag" || true
    done
    local keep_backup; keep_backup="$(json_get "$LAST_SUCCESS" prev.db_backup "")"
    local db; db="$(sqlite_path_from_ini "$REPO_DIR/config/production.ini")"
    if [ -n "$db" ] && [ -d "$REPO_DIR/backups" ]; then
        local n=0 f
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            [ "$f" = "$keep_backup" ] && continue
            n=$((n+1))
            [ "$n" -le "$BACKUP_KEEP" ] && continue
            rm -f "$f" && echo "    rm $(basename "$f")"
        done < <(ls -1t "$REPO_DIR/backups/$(basename "$db")".* 2>/dev/null | grep -v -- '-wal$' || true)
    fi
    docker image prune -f >/dev/null 2>&1 || true
}

case "${1:-}" in
    run) shift; cmd_run "$@" ;;
    --close-in-progress) cmd_close_in_progress ;;
    status) cmd_status ;;
    *) echo "用法: $0 run <vX.Y.Z> <sha40> <0|1> <0|1> | --close-in-progress | status" >&2; exit 2 ;;
esac
